# Which CMS the app talks to. All three serve the same content model (schema/ at the repo root).
VITE_CMS_PHP_URL=http://localhost:1337
VITE_CMS_NODE_URL=http://localhost:1338
VITE_CMS_CAMIS_URL=http://localhost:1339
VITE_CMS_DEFAULT=php

# Development only: an API token per CMS (admin panel > Settings > API Tokens).
# The content API is closed by default; a real login (users-permissions) replaces these later.
VITE_CMS_PHP_TOKEN=
VITE_CMS_NODE_TOKEN=
VITE_CMS_CAMIS_TOKEN=
