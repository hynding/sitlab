# Which CMS the app talks to. Both serve the same content model (schema/ at the repo root).
VITE_CMS_PHP_URL=http://localhost:1337
VITE_CMS_NODE_URL=http://localhost:1338
VITE_CMS_DEFAULT=php

# Development only, optional: an API token per CMS (admin panel > Settings > API Tokens), used while
# nobody is signed in. Signing up or in from the app uses users-permissions instead. Never set these
# for a deployed build: anything VITE_ ends up in the public JavaScript.
VITE_CMS_PHP_TOKEN=
VITE_CMS_NODE_TOKEN=
