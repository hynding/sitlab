# Apache (DreamHost shared hosting): every request that is not a file under public/ goes to the
# front controller. The site's web directory must be this public/ folder, not the app root, so that
# .env, vendor/ and config/ are never served.
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # PHP under FastCGI drops the Authorization header; pass it on so API tokens and admin JWTs work
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # The deploy copies the admin bundle (build/) to public/admin/ so Apache serves its files without
    # booting the app. /admin itself gets the bundle's index.html, as Strapi answers it (no redirect).
    DirectorySlash Off
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^admin/?$ admin/index.html [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Same caching as Strapi's admin handler: hashed bundle files for a year, index.html revalidated
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/admin/.+# && -f %{REQUEST_FILENAME}">
        Header set Cache-Control "public, max-age=31536000"
    </If>
    <If "%{REQUEST_URI} =~ m#^/admin(/(index\.html)?)?$#">
        Header set Cache-Control "no-cache"
    </If>
</IfModule>
