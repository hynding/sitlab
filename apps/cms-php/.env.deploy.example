# The cms-php .env on the server, one per environment (dev and production).
#
# Generate .env.dev and .env.production (both git-ignored) from this file with fresh secrets:
#
#   node scripts/init-env.mjs --deploy dev
#   node scripts/init-env.mjs --deploy production
#
# fill in the database username and password, then store each one as the ENV_FILE secret of its
# GitHub environment:
#
#   gh secret set ENV_FILE --env dev        < apps/cms-php/.env.dev
#   gh secret set ENV_FILE --env production < apps/cms-php/.env.production
#
# Every deploy writes it to <API_PATH>/.env. Generate the secrets once per environment and keep them:
# changing APP_KEYS, ADMIN_JWT_SECRET or JWT_SECRET signs everyone out, changing API_TOKEN_SALT
# invalidates every API token, and changing ENCRYPTION_KEY makes stored encrypted values unreadable.

NODE_ENV=production
# https://api-dev.sitlab.dev for dev, https://api.sitlab.dev for production
PUBLIC_URL=https://api.sitlab.dev

# Four comma-separated random values, then one random value each
APP_KEYS="tobemodified1,tobemodified2,tobemodified3,tobemodified4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# DreamHost MySQL: sitlab_dev for dev, sitlab_prod for production, each with its own user
DATABASE_CLIENT=mysql
DATABASE_HOST=mysql.sitlab.dev
DATABASE_PORT=3306
DATABASE_NAME=sitlab_prod
DATABASE_USERNAME=tobemodified
DATABASE_PASSWORD=tobemodified
DATABASE_SSL=false
