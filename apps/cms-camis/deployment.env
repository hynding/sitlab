# From the Strapi project's config/plugins, config/api and config/middlewares.
# ${NAME} reads the variable the Strapi project read: copy it from that project's .env.

# Upload: local
CAMIS_UPLOAD_ALLOWED_TYPES="image/*,video/*,audio/*,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.*,text/plain,text/csv"
CAMIS_UPLOAD_DENIED_TYPES="image/svg+xml,application/vnd.microsoft.portable-executable,application/x-msdownload,application/x-msdos-program,application/x-executable,application/x-dosexec,application/x-sh,text/x-shellscript,application/x-mach-binary"

# REST API
CAMIS_REST_DEFAULT_LIMIT=25
CAMIS_REST_MAX_LIMIT=100
CAMIS_REST_WITH_COUNT=true

# Users & Permissions
CAMIS_JWT_MANAGEMENT=refresh
CAMIS_SESSIONS_HTTP_ONLY=true
