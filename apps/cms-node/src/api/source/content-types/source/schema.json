{
  "kind": "collectionType",
  "collectionName": "sources",
  "info": {
    "singularName": "source",
    "pluralName": "sources",
    "displayName": "Source",
    "description": "Researched public material a story draws on, attachable to characters and scenes"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "regex": "^https?://"
    },
    "topic": {
      "type": "enumeration",
      "enum": [
        "person",
        "place",
        "era",
        "event",
        "organization",
        "work",
        "other"
      ]
    },
    "wikidataId": {
      "type": "string",
      "regex": "^Q[0-9]+$"
    },
    "excerpt": {
      "type": "text"
    },
    "period": {
      "type": "string"
    },
    "imageUrl": {
      "type": "string",
      "regex": "^https?://"
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "article",
        "book",
        "dataset",
        "image",
        "video",
        "audio",
        "archive",
        "other"
      ],
      "default": "article"
    },
    "publisher": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "accessedOn": {
      "type": "date"
    },
    "notes": {
      "type": "text"
    },
    "stories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::story.story",
      "mappedBy": "sources"
    },
    "characters": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::character.character",
      "inversedBy": "sources"
    },
    "scenes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::scene.scene",
      "inversedBy": "sources"
    }
  }
}
